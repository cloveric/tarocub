{
  "name": "tarocub",
  "version": "0.1.311",
  "description": "Feishu/Lark-first local AI agent gateway for Codex, Claude Code, Kimi Code, DeepSeek Harness, and Antigravity.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/cloveric/tarocub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloveric/tarocub.git"
  },
  "bugs": {
    "url": "https://github.com/cloveric/tarocub/issues"
  },
  "keywords": [
    "feishu",
    "lark",
    "codex",
    "claude-code",
    "kimi-code",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "ai-agents",
    "multi-agent",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build web && node scripts/inline-web.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "smoke:claude-auth": "bash scripts/smoke-claude-auth.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:deepseek-plugin": "npm --prefix deepseek-harness-plugin run verify",
    "publish:deepseek-plugin": "bash scripts/publish-deepseek-harness-plugin.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.23.0",
    "@larksuiteoapi/node-sdk": "^1.70.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "croner": "^10.0.1",
    "https-proxy-agent": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3",
    "zod": "^4.1.5"
  },
  "overrides": {
    "axios": "1.18.1",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "vite": "$vite"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
